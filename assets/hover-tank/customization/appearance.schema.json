{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "MORK appearance recipe v1",
  "type": "object",
  "required": [
    "schema_version",
    "asset_family",
    "preset_id",
    "label",
    "paint",
    "pattern",
    "finish",
    "name",
    "number",
    "message",
    "decals"
  ],
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "const": 1
    },
    "asset_family": {
      "const": "mork_hover_tank"
    },
    "preset_id": {
      "type": "string",
      "maxLength": 48
    },
    "label": {
      "type": "string",
      "maxLength": 60
    },
    "paint": {
      "type": "object",
      "required": [
        "primary",
        "secondary",
        "accent"
      ],
      "additionalProperties": false,
      "properties": {
        "primary": {
          "type": "string",
          "pattern": "^#[0-9a-fA-F]{6}$"
        },
        "secondary": {
          "type": "string",
          "pattern": "^#[0-9a-fA-F]{6}$"
        },
        "accent": {
          "type": "string",
          "pattern": "^#[0-9a-fA-F]{6}$"
        }
      }
    },
    "pattern": {
      "enum": [
        "solid",
        "rabbit-chaos",
        "circuit",
        "camouflage"
      ]
    },
    "finish": {
      "enum": [
        "factory",
        "satin",
        "matte"
      ]
    },
    "name": {
      "type": "string",
      "maxLength": 18,
      "pattern": "^[A-Z0-9 /!?-]*$"
    },
    "number": {
      "type": "string",
      "maxLength": 3,
      "pattern": "^[A-Z0-9 /!?-]*$"
    },
    "message": {
      "type": "string",
      "maxLength": 24,
      "pattern": "^[A-Z0-9 /!?-]*$"
    },
    "decals": {
      "type": "array",
      "minItems": 3,
      "maxItems": 3,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "zone",
          "symbol",
          "scale",
          "rotation"
        ],
        "properties": {
          "zone": {
            "enum": [
              "turret",
              "badge",
              "message"
            ]
          },
          "symbol": {
            "enum": [
              "none",
              "rabbit",
              "circuit",
              "star"
            ]
          },
          "scale": {
            "type": "number",
            "minimum": 0.2,
            "maximum": 1.5
          },
          "rotation": {
            "type": "number",
            "minimum": -180,
            "maximum": 180
          },
          "offset_x": {
            "type": "number",
            "minimum": -0.4,
            "maximum": 0.4,
            "default": 0
          },
          "offset_y": {
            "type": "number",
            "minimum": -0.4,
            "maximum": 0.4,
            "default": 0
          },
          "number_scale": {
            "type": "number",
            "minimum": 0.4,
            "maximum": 1.6,
            "default": 1
          }
        }
      }
    },
    "wear": {
      "type": "number",
      "minimum": 0,
      "maximum": 1,
      "default": 0
    }
  }
}
