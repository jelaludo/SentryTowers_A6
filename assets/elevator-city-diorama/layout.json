  "chapters": [
    {
      "id": "city",
      "start": 0,
      "end": 12,
      "title": "A city on the surface",
      "detail": "Eight connected domes, a central plaza and one elevator terminal."
    },
    {
      "id": "approach",
      "start": 12,
      "end": 24,
      "title": "Find the climber",
      "detail": "The camera leaves the streets and closes on the tether cabin."
    },
    {
      "id": "depart",
      "start": 24,
      "end": 32,
      "title": "Leave the city",
      "detail": "The first part of the ascent plays at normal travel speed."
    },
    {
      "id": "accelerate",
      "start": 32,
      "end": 36,
      "title": "Accelerate to 20×",
      "detail": "Time compression rises smoothly from 1× to 20×."
    },
    {
      "id": "ascent",
      "start": 36,
      "end": 46,
      "title": "Above the settlement",
      "detail": "Follow the climber as the city falls away below."
    },
    {
      "id": "gunship",
      "start": 46,
      "end": 60,
      "title": "KORP passes",
      "detail": "The heavy gunship crosses behind the tether on its own flight path."
    },
    {
      "id": "arrival",
      "start": 60,
      "end": 78,
      "title": "The orbital harbour",
      "detail": "The terminal comes into view. The climber brakes and docks below it."
    },
    {
      "id": "sol",
      "start": 78,
      "end": 98,
      "title": "Two quiet sentinels",
      "detail": "SOL-82 and SOL-88 drift behind the terminal at different angular speeds."
    },
    {
      "id": "complete",
      "start": 98,
      "end": 112,
      "title": "One connected settlement",
      "detail": "Hold on the orbital terminal, the two SOL platforms and the world below."
    }
  ],
