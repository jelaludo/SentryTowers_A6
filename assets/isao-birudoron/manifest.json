  "status": "production_alpha",
  "plain_glb_source_of_truth": true,
  "units": "meters",
  "up": "+Y",
  "project_forward": "+Z",
  "lore": {
    "role": "Flying construction specialist that assembles the Stålheart Terraformer before it fabricates MÖRK vehicles.",
    "manufacturer": "ISAO Robotics",
    "manufacturer_country": "Japan",
    "name_note": "Birudorōn is a playful romanization of ビルドローン: build drone. Manufacturer identity is working fiction for the remake."
  },
  "design_direction": {
    "status": "production_alpha_implemented",
    "summary": "Retain the readable LED face and four-limb construction silhouette, rebuilt in the MÖRK/KORP design language.",
    "shared_language": [
      "faceted dark graphite armor",
      "recessed cyan lift and tool emitters",
      "restrained amber service markings",
      "purposeful chamfers and mechanical panel breaks"
    ],
    "emotion_rule": "Every authored emotion combines an LED-panel expression with a body, limb or tool-head gesture; the screen alone is not the performance."
  },
  "emotion_system": {
    "reference_url": "https://kai-denrei.github.io/braille-lab/emotions/index.html",
    "adaptation_note": "Original 8 × 6 LED glyphs inspired by the reference's emotional readability; no Braille cells or encoded characters are embedded. Curious adapts the scan principle by moving only the pupils left, center and right.",
    "performance_channels": [
      "LED dot pattern",
      "LED pattern animation",
      "limb and body animation",
      "emotion-family color"
    ],
    "palette": {
      "neutral_puzzled_determined": "amber",
      "happy_positive": "green",
      "alarm_angry_adjacent": "red",
      "sad_negative": "purple",
      "working_functional": "cyan",
      "love_rare": "pink"
    }
  },
